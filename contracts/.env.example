# Settings for deploying Moonshard's contracts to Celo. Copy this file to contracts/.env and fill it in:
#   cp .env.example .env
# Git ignores .env files, so contracts/.env never leaves your computer. Foundry reads it by itself when you run
# `forge script` in this folder.

# The private key of the wallet that deploys. It pays the gas (keep about 1 CELO in it) and owns the vault.
# Paste it with or without 0x in front. Remove it from this file once you have finished deploying.
DEPLOYER_PRIVATE_KEY=

# The ADDRESS (not the key) of the server's voucher signer. Make one with `cast wallet new`: the address goes here, the
# private key goes on the server as VOUCHER_SIGNER_KEY (server/.env, and the API's variables when it is deployed).
VOUCHER_SIGNER=

# The ADDRESS of the server's app signer, for GoodDollar's Engagement Rewards (a second `cast wallet new`). Its private key
# goes on the server as APP_SIGNER_KEY.
APP_SIGNER=

# The vault's limits, in whole G$. The most one voucher can pay: at least 1000 (the first daily prize). The most the vault
# pays in one UTC day: at least 1900 (the three daily prizes) plus 100 for each player who cashes out a Shard Harvest.
MAX_PER_VOUCHER_G=1000
DAILY_CAP_G=5000

# G$ to move from the deploying wallet into the vault right after it is deployed (the prize pool). 0 = you fund it later.
FUND_G=0

# For the Engagement Rewards registration (script/RegisterApp.s.sol). Both are stored publicly on-chain.
APP_URL=https://
APP_EMAIL=

# Optional: a different owner for the vault, for example a Safe multisig. Leave it empty to own the vault yourself.
VAULT_OWNER=
