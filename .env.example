# Web client (Vite)
VITE_API_URL=http://localhost:3001
VITE_CELO_RPC_URL=https://forno.celo.org
VITE_GD_ENV=production
# Optional: enables WalletConnect for phones without an injected wallet (free project id at reown.com)
VITE_REOWN_PROJECT_ID=
# Optional: enables "Continue with email" (Magic, magic.link): a player signs in with an email and gets a wallet, nothing to
# install. The publishable key (pk_live_... or pk_test_...) from dashboard.magic.link; in the dashboard, allow this site's
# origin (and http://localhost:5173 for development). The key is public: it is in the page.
VITE_MAGIC_PUBLISHABLE_KEY=
# The deployed MoonshardVault. When set, the app refuses to redeem against any other vault address.
VITE_VAULT_ADDRESS=
# Optional: the address players' invite links point at (https://playmoonshard.xyz). Unset, a link uses the page the player is on,
# which is right on the live site and would be a preview address on a preview deployment.
VITE_PUBLIC_URL=
