# Moonshard API
PORT=3001
# Signs sessions and run tickets. Required: 32+ random characters, e.g. from `openssl rand -base64 32`.
# The server refuses to start while this is empty, shorter than 32 characters, or still this placeholder.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to "production" when deployed. Then an unset CORS_ORIGINS (or "*") sends no CORS headers at all, instead of allowing
# every origin as it does in development, so CORS_ORIGINS must be your site's origin.
# NODE_ENV=production
# Optional: log requests the server refused as the client's mistake (bad JSON, too large, wrong type), which is otherwise quiet.
# LOG_LEVEL=debug
# Reverse proxies between the internet and this API (Railway, Render, Fly: 1). The per-IP rate limiter
# reads the client address from X-Forwarded-For using this hop count. Use 0 if the API is exposed directly;
# never "true" (it trusts a header any client can set).
TRUST_PROXY=1
# Requests per minute allowed from one IP address to /api (default 300). Players behind one public address (a mobile
# carrier, a school, a household) share it, and one active player costs about 14 requests a minute: raise it if you expect that.
# RATE_LIMIT_PER_MIN=300
# Empty DATABASE_URL = in-memory PGlite (dev only; data is lost on restart). With NODE_ENV=production the server refuses to
# start without one (scores, settled days and unredeemed Spoils would vanish on every restart); ALLOW_IN_MEMORY_DB=1 overrides
# that for a throwaway demo.
# For hosted Postgres use e.g. postgres://user:pass@host:5432/db?sslmode=require
# (TLS is always verified; set DATABASE_CA to the PEM text only if the host uses a private CA).
DATABASE_URL=
# CA certificate as PEM text with real line breaks, only for a Postgres host that uses a private CA.
# DATABASE_CA=
CELO_RPC_URL=https://forno.celo.org
CHAIN_ID=42220
# MoonshardVault address after deployment (leave empty to disable Spoils vouchers). Set it only together with VOUCHER_SIGNER_KEY:
# in production the server refuses to start with a vault it cannot sign vouchers for.
VAULT_ADDRESS=
# Key that signs Spoil vouchers. Can only mint vouchers within the vault's on-chain caps.
VOUCHER_SIGNER_KEY=
# Key whose address is registered as the Engagement Rewards "app". Signs attestations only; holds no funds.
APP_SIGNER_KEY=
# Whether the game pays prizes from the vault: the daily top 3 and the Shard Harvest. Off unless set to true (no prizes
# until the game has players; paying them needs G$ in the vault, see docs/DEPLOY.md). The daily G$ claim, the first-boss
# bounty and the Moon Shop are not prizes and work either way. With it off, VOUCHER_SIGNER_KEY is not needed.
PRIZES_ENABLED=false
